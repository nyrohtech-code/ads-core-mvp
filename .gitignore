# ============================================================================
# ADS CORE MVP - Git Ignore
# ============================================================================

# Environment Variables (CRITICAL - NEVER COMMIT)
.env
.env.local
.env.*.local
.env.production
.env.development

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.project
.pydevproject
.settings/

# OS
.DS_Store
Thumbs.db
Desktop.ini
.Spotlight-V100
.Trashes

# Logs
logs/
*.log
npm-debug.log*

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Database
*.db
*.sqlite
*.sqlite3
local_database/

# Docker
.docker/
docker-compose.override.yml

# n8n
.n8n/
n8n_backup/

# Credentials & Secrets
*credentials*
*secret*
*key*
*.pem
*.key
*.crt

# Test coverage
coverage/
.coverage
.nyc_output/

# Build outputs
dist/
build/
out/

# Generated files
.generated/

# IDE specific
.vscode/settings.json
.idea/workspace.xml
.idea/tasks.xml

# Next.js
.next/
out/
.vercel/

# Keep these directories but ignore large files inside
src/mcp/**/node_modules/
src/frontend/.next/
src/frontend/out/

# Private/sensitive data
src/scripts/test_data/
notes/private_*
*.private.md

# Don't ignore these (commented out for reference)
# !.gitkeep
# !config/
# !docs/
