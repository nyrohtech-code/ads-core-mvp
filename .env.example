# ============================================================================
# ADS CORE MVP - Environment Variables
# ============================================================================
# Copie este arquivo para .env e preencha com suas credenciais reais
# cp .env.example .env
# ============================================================================

# ---- SUPABASE (Banco de Dados) ----
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_DB_PASSWORD=sua_senha_banco

# ---- CLAUDE AI (Anthropic) ----
CLAUDE_API_KEY=sk-ant-xxxxx...

# ---- META ADS (Facebook/Instagram) ----
META_ACCESS_TOKEN=seu_meta_token_aqui
META_BUSINESS_ACCOUNT_ID=123456789
META_APP_ID=seu_app_id
META_APP_SECRET=seu_app_secret

# ---- GOOGLE ADS ----
GOOGLE_ADS_DEVELOPER_TOKEN=seu_developer_token
GOOGLE_ADS_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=seu_client_secret
GOOGLE_ADS_REFRESH_TOKEN=seu_refresh_token
GOOGLE_ADS_CUSTOMER_ID=1234567890

# ---- IDEOGRAM (Geração de Imagens) ----
IDEOGRAM_API_KEY=seu_ideogram_key
IDEOGRAM_API_URL=https://api.ideogram.ai

# ---- N8N (Orquestração) ----
N8N_HOST=localhost
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=seu_usuario
N8N_BASIC_AUTH_PASSWORD=sua_senha
N8N_ENCRYPTION_KEY=sua_encryption_key_aqui

# ---- NOTIFICAÇÕES (Opcional) ----
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxxx
SENDGRID_API_KEY=SG.xxxxx...
SENDGRID_FROM_EMAIL=noreply@seu-dominio.com

# ---- AMBIENTE ----
NODE_ENV=development
# production, staging, development

# ---- STRIPE (Billing) ----
STRIPE_SECRET_KEY=sk_test_xxxxx...
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx...
STRIPE_WEBHOOK_SECRET=whsec_xxxxx...

# ---- CLIENTE DE TESTE (FASE 0) ----
TEST_CLIENT_NAME="Cliente Teste XYZ"
TEST_CLIENT_NICHE="e-commerce"
TEST_CLIENT_BUDGET_MONTHLY=5000
TEST_CLIENT_META_ACCOUNT_ID=xxxxx
TEST_CLIENT_GOOGLE_CUSTOMER_ID=xxxxx

# ---- LOGGING ----
LOG_LEVEL=info
# error, warn, info, debug, verbose

# ---- DATABASE ----
DATABASE_URL=postgresql://user:password@localhost:5432/ads_core_db

# ---- FRONTEND (Next.js) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_API_URL=http://localhost:3000
